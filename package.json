  "scripts": {
    "dev": "expo start",
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/generate-icons.js",
    "build:web": "expo export --platform web",
    "eas:login": "npx --yes eas-cli@latest login",
    "eas:init": "npx --yes eas-cli@latest init",
    "eas:whoami": "npx --yes eas-cli@latest whoami",
    "build:dev": "npx --yes eas-cli@latest build --profile development --platform all",
    "build:preview": "npx --yes eas-cli@latest build --profile preview --platform android",
    "build:prod": "npx --yes eas-cli@latest build --profile production --platform all",
    "submit:ios": "npx --yes eas-cli@latest submit --platform ios --profile production",
    "submit:android": "npx --yes eas-cli@latest submit --platform android --profile production",
    "update": "npx --yes eas-cli@latest update --branch production"

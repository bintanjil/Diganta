{
  "expo": {
    "name": "Diganta",
    "slug": "diganta",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "diganta",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.diganta.app",
      "supportsTablet": true
    },
    "android": {
      "package": "com.diganta.app",
      "adaptiveIcon": {
        "backgroundColor": "#046A48",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#046A48",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220
        }
      ],
      "expo-sharing",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#00875A"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Diganta lets you attach receipt photos to your expenses.",
          "cameraPermission": "Diganta lets you take receipt photos for your expenses."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Diganta uses your location to show accurate prayer times."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2bfd37c2-c3a9-49d7-b3bd-12e59807110f"
      }
    },
    "owner": "bintanjil"
  }
}
